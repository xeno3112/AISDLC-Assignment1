# Only the submission entry points and application directories are eligible.
/*
!/.gitignore
!/README.md
!/pom.xml
!/mvnw
!/mvnw.cmd
!/.mvn/
!/tiered-rate-limiter/
!/semantic-code-review-assistant/
!/Part-1A/
!/Part-1B/
!/Part-1B/**

# Keep other hidden directories private while allowing project tooling.
**/.*/
!/.mvn/
!/tiered-rate-limiter/.agents/
!/tiered-rate-limiter/.specify/
!/tiered-rate-limiter/.harness/
!/semantic-code-review-assistant/.agents/
!/semantic-code-review-assistant/.specify/
!/semantic-code-review-assistant/.harness/
!/Part-1A/.specify/
!/Part-1A/.specify/**
!/Part-1A/.harness/
!/Part-1A/.harness/**
!/Part-1B/.github/
!/Part-1B/.github/**
!/Part-1B/.harness/
!/Part-1B/.harness/**
!/Part-1B/.specify/
!/Part-1B/.specify/**
!/Part-1B/.gitignore
!/Part-1B/.prettierignore
!/Part-1B/.prettierrc.json

# Exclude local build products, environment files, keys, and dependencies.
**/target/
**/dist/
**/build/
**/coverage/
**/*.log
**/.DS_Store
**/.env*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/node_modules/
