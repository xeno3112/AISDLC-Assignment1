{
  "name": "support-ticket-desk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --parallel --if-present",
    "start": "npm run start --workspace=@support-ticket-desk/backend",
    "build": "npm run build --workspaces --if-present",
    "test:frontend": "vitest run tests/unit/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "security": "bash ./.harness/security/run.sh",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract/api",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:backend": "vitest run tests/unit/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
