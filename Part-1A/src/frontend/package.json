{
  "name": "@support-ticket-desk/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "openapi:types": "openapi-typescript ../../specs/001-support-ticket-desk/contracts/openapi.yaml -o src/api/openapi.ts",
    "openapi:check": "openapi-typescript ../../specs/001-support-ticket-desk/contracts/openapi.yaml -o src/api/openapi.ts --check"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.1",
    "vite": "^8.0.0"
  }
}
